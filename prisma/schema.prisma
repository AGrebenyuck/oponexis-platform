generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  clerkUserId  String?       @unique
  zadarmaId    String?
  email        String?       @unique
  phone        String?
  name         String?
  username     String?
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bonuses      Bonus[]
  comments     Comment[]
  referee      Referral[]    @relation("Referee")
  referrals    Referral[]    @relation("Referrer")
  reservations Reservation[]
  sources      UserSource[]
}

model PlatformCredential {
  role           String            @id
  passwordHash   String
  passwordSalt   String
  sessionVersion Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       PlatformSession[]
}

model PlatformAuthSetting {
  id          String   @id @default("platform")
  sessionDays Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSession {
  id          String             @id @default(cuid())
  role        String
  credential  PlatformCredential @relation(fields: [role], references: [role], onDelete: Cascade)
  deviceLabel String?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([role, revokedAt, expiresAt])
  @@index([lastSeenAt])
}

model Partner {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique // что пойдёт в ?ref=
  commissionPct Float    @default(10) // процент партнёра, %
  createdAt     DateTime @default(now())
}

model ReferralHit {
  id          String   @id @default(cuid())
  partnerCode String
  visitorId   String
  day         String // 'YYYY-MM-DD'
  createdAt   DateTime @default(now())

  @@unique([partnerCode, visitorId, day]) // 1 хит/день/визитор/партнёр
}

model CallIntent {
  id          String   @id @default(cuid())
  partnerCode String
  visitorId   String?
  ua          String?
  createdAt   DateTime @default(now())

  @@index([partnerCode, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  phone       String
  serviceId   String
  serviceName String?
  selectedIds String[] @default([])

  partnerCode String?
  ua          String?
  ip          String?
  status      String  @default("new")

  selectedNames String[] @default([])

  monthKey String?

  firstTouchSource      String?
  firstTouchMedium      String?
  firstTouchCampaign    String?
  firstTouchContent     String?
  firstTouchTerm        String?
  firstTouchReferrer    String?
  firstTouchLandingPage String?
  firstTouchGclid       String?
  firstTouchFbclid      String?
  firstTouchTtclid      String?
  firstTouchMsclkid     String?
  firstTouchAt          DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  WorkOrder WorkOrder[]
}

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone  String  @unique
  name   String?
  gender String?
  source String?
  notes  String?
  isTest Boolean @default(false)

  leads                       Lead[]
  workOrders                  WorkOrder[]
  completions                 WorkOrderCompletion[]
  seasonStatuses              CustomerSeasonStatus[]
  smsRecipients               SmsCampaignRecipient[]
  smsContactEvents            SmsContactEvent[]
  mobileCallEvents            MobileCallEvent[]
  smsReservationConfirmations SmsReservationConfirmation[]

  @@index([name])
  @@index([source])
}

model MobileCallEvent {
  eventId            String    @id @db.Uuid
  callRef            String    @db.Uuid
  schemaVersion      Int
  eventType          String
  source             String
  confidence         String
  observedAt         DateTime
  resolvedAt         DateTime
  disconnectCategory String
  durationBucket     String
  outcomeCode        String
  phone              String?
  payloadHash        String
  receivedAt         DateTime  @default(now())
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId, receivedAt])
  @@index([callRef])
  @@index([receivedAt])
}

model CustomerSeasonStatus {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  season        String
  year          Int
  status        String    @default("NOT_CONTACTED")
  note          String?
  lastContactAt DateTime?
  nextContactAt DateTime?

  @@unique([customerId, season, year])
  @@index([season, year, status])
}

model WorkOrder {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  name    String
  phone   String
  service String?
  status  String  @default("new")

  regNumber String?
  color     String?
  carModel  String?

  // koła / opony
  wheelRimSize String? @db.VarChar(8) // np. R16
  tireSize     String? @db.VarChar(32) // np. 205/55 R16

  address String?
  lat     Float?
  lng     Float?

  notes     String?
  visitDate DateTime?
  visitTime String?

  telegramMessageId Int?

  wantsInvoice Boolean @default(false)
  invoiceNip   String? @db.VarChar(32)
  invoiceEmail String? @db.VarChar(191)

  completions                 WorkOrderCompletion[]
  smsReservationConfirmations SmsReservationConfirmation[]

  @@index([customerId])
  @@index([phone])
  @@index([visitDate])
}

model FinanceTransaction {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  occurredAt DateTime @default(now())

  type         String
  status       String  @default("PAID")
  category     String
  amount       Float
  description  String?
  counterparty String?
  externalRef  String? @unique

  @@index([occurredAt])
  @@index([type, status])
  @@index([category])
}

model WorkOrderCompletion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  workOrderId Int?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  formSubmittedAt DateTime?
  completedAt     DateTime?

  name          String?
  phone         String
  gender        String?
  source        String?
  car           String?
  serviceUsed   Boolean?
  serviceNames  String[] @default([])
  amount        Float?
  invoiceIssued Boolean?
  paymentMethod String?
  notes         String?

  importSource  String? // google_forms, internal_form, csv
  importRowHash String? @unique
  isTest        Boolean @default(false)
  rawData       Json?

  customAnswers CompletionFormAnswer[]

  @@index([customerId])
  @@index([workOrderId])
  @@index([phone])
  @@index([completedAt])
}

model CompletionFormQuestion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key         String  @unique
  label       String
  type        String
  required    Boolean @default(false)
  options     Json?
  position    Int     @default(0)
  active      Boolean @default(true)
  description String?

  answers CompletionFormAnswer[]

  @@index([active, position])
}

model CompletionFormAnswer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completionId String
  questionId   String
  value        Json?
  valueText    String?

  completion WorkOrderCompletion    @relation(fields: [completionId], references: [id], onDelete: Cascade)
  question   CompletionFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([completionId, questionId])
  @@index([questionId])
}

model CompletionFormOptionSet {
  key       String   @id
  options   Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SmsFormLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone   String
  name    String?
  service String?
  source  String? // 'lead', 'manual', 'sms-redirect' и т.п.
  leadId  String?

  // 'pending' – отправили СМС, ждём форму
  // 'done'    – форма пришла, заказ создан
  // 'deleted' – скрыто вручную (не показываем в трекере)
  status String @default("pending")

  sentAt DateTime @default(now())

  publicToken               String?   @unique
  mobileRequestId           String?   @unique
  templateKey               String?
  formUrl                   String?
  providerMessageId         String?
  reminderProviderMessageId String?
  // Delivery is separate from the form lifecycle (`status`: pending/done/expired).
  deliveryStatus            String? // QUEUED, SENT, DELIVERED, FAILED, CANCELLED
  deliveryError             String?
  deliveryUpdatedAt         DateTime?
  reminderSentAt            DateTime?
  expiresAt                 DateTime?
  expiredAt                 DateTime?
  managerNotifiedAt         DateTime?

  // 👉 новое:
  visitDate DateTime? // дата визита из sms-redirect (YYYY-MM-DD)
  visitTime String? // час визита "HH:MM"

  completedAt  DateTime?
  confirmation SmsReservationConfirmation?

  @@index([status, sentAt])
  @@index([status, expiresAt])
}

model SmsTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  body     String
  kind     String // BOOKING_FORM, MESSAGE
  audience String // NEW, RETURNING, ALL
  active   Boolean @default(true)

  @@index([active, audience, kind])
}

model SmsReservationConfirmation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  smsFormLogId Int        @unique
  smsFormLog   SmsFormLog @relation(fields: [smsFormLogId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  workOrderId  Int?       @unique
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])

  status                 String    @default("WAITING")
  replyProviderMessageId String?   @unique
  replyText              String?
  confirmedAt            DateTime?

  @@index([customerId, status])
  @@index([status, createdAt])
}

model SmsCampaign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  message String
  status  String @default("DRAFT") // DRAFT, RUNNING, COMPLETED, FAILED, CANCELLED

  sourceSeason String?
  sourceYear   Int?
  filters      Json?

  delaySeconds Int       @default(7)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?

  recipients    SmsCampaignRecipient[]
  contactEvents SmsContactEvent[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model SmsCampaignRecipient {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  campaign   SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  name  String?
  phone String

  status            String            @default("PENDING") // PENDING, SENT, FAILED, CANCELLED, BOOKED, DECLINED, CALL_BACK
  providerMessageId String?
  sentAt            DateTime?
  failedAt          DateTime?
  error             String?
  note              String?
  contactEvents     SmsContactEvent[]

  @@index([campaignId])
  @@index([customerId])
  @@index([phone])
  @@index([status])
}

model SmsContactEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String?
  campaign   SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   SmsCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  direction         String // IN, OUT, CALL, NOTE
  type              String // sms_received, sms_sent, call_in, call_out, note
  phone             String?
  message           String?
  providerMessageId String?
  occurredAt        DateTime @default(now())
  raw               Json?

  @@unique([providerMessageId, type])
  @@index([campaignId])
  @@index([recipientId])
  @@index([customerId])
  @@index([phone])
  @@index([occurredAt])
}

model MobilePushDevice {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  installationId String @unique
  appId      String
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())

  @@index([enabled, lastSeenAt])
}

model GoogleReviewsCache {
  id        String   @id @default("google") // один глобальный ряд
  payload   Json
  rating    Float?
  total     Int?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id                      String               @id @default(cuid())
  userId                  String
  address                 String
  serviceName             String
  contactInfo             String
  additionalInfo          String?
  promoCode               String?
  zadarmaDealId           String?
  zadarmaTaskId           String?
  startTime               DateTime
  endTime                 DateTime
  price                   Float
  status                  String               @default("pending")
  serviceNameIds          String[]             @default([])
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    User                 @relation(fields: [userId], references: [id])
  services                ServiceReservation[] @relation("ReservationServices")
  // атрибуция
  partnerCode             String?
  partnerCommissionAmount Float? // комиссия партнёру в zł (под твой float)
}

model Service {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  duration           Int
  price              Float
  originalPrice      Float?
  additionalServices AdditionalServices[] @relation("serviceAdditional")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  reservations       ServiceReservation[]
}

model AdditionalServices {
  id          String   @id @default(cuid())
  service     Service? @relation("serviceAdditional", fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String?
  name        String
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromoCode {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String
  value      Float
  maxUses    Int?
  uses       Int       @default(0)
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String
  level       Int      @default(1)
  bonusAmount Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  referee     User     @relation("Referee", fields: [refereeId], references: [id])
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id])
}

model Bonus {
  id        String    @id @default(cuid())
  userId    String
  amount    Float
  type      String
  source    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  service   String
  text      String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model UserSource {
  id        String   @id @default(cuid())
  userId    String
  source    String
  campaign  String?
  medium    String?
  term      String?
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model ServiceReservation {
  id            String      @id @default(cuid())
  reservationId String
  serviceId     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reservation   Reservation @relation("ReservationServices", fields: [reservationId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])
}

model Calendar {
  id        String            @id @default(cuid())
  timeGap   Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  days      DayAvailability[]
}

model DayAvailability {
  id             String    @id @default(uuid())
  availabilityId String
  day            DayOfWeek
  startTime      DateTime
  endTime        DateTime
  availability   Calendar  @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
}

model SentNotification {
  id        String   @id @default(cuid())
  date      DateTime @unique
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
